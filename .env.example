# Copy to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/jsb414?schema=public
BCRYPT_SALT_ROUNDS=12
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES=7d
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=false

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ADDRESS=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_EXPIRES=10m
EMAIL_TO=
ADMIN_EMAIL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Deployment: immutable Git commit SHA, not "latest".
DOCKER_USERNAME=
IMAGE_TAG=
# Backup tooling uses a PostgreSQL URL without Prisma-specific ?schema= parameters.
BACKUP_DATABASE_URL=
BACKUP_DIR=/var/backups/foreclosure-gold
