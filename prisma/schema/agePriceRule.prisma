model AgePriceRule {
  id String @id @default(uuid())

  minDays Int
  maxDays Int? // null মানে কোনো ঊর্ধ্বসীমা নেই (যেমন: ৯১+ দিন)

  // বয়সভিত্তিক ডিসকাউন্ট পার্সেন্টেজ (যেমন: ১৫ মানে ১৫% ছাড়)
  discountPercent Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("age_price_rules")
}
