model ContactUs {
  id String @id @default(uuid())

  name        String
  email       String
  phoneNumber String?

  subject String?
  message String

  status     ContactStatus @default(PENDING)
  adminReply String?
  resolvedAt DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contactus")
}
