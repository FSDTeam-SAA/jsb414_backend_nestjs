model ContactUs {
  id String @id @default(uuid())

  firstName   String?
  lastName    String?
  name        String
  email       String
  phoneNumber String?

  type      String?  @default("CONTACT") // CONTACT (Send Us A Message) or SUPPORT (Submit A Support Request)
  issueType String? // String data (Lead type or Issue type from frontend dropdown, no enum)

  subject String?
  message String

  status     ContactStatus @default(PENDING)
  adminReply String?
  resolvedAt DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([email])
  @@index([userId])
  @@map("contactus")
}
