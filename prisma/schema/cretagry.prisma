model Catagorie {
  id          String  @id @default(uuid())
  name        String
  description String?
  logo        String?

  isActive          Boolean @default(true)
  agePricingEnabled Boolean @default(false)

  sharedBasePriceCents    Int?
  exclusiveBasePriceCents Int?

  leads         Lead[]
  agePriceRules AgePriceRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catagories")
}
