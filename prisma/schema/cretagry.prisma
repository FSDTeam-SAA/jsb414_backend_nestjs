model Catagorie {
  id          String  @id @default(uuid())
  name        String
  description String?
  logo        String?

  isActive          Boolean @default(true)
  agePricingEnabled Boolean @default(false)

  sharedBasePrice    Decimal? @db.Decimal(14, 2)
  exclusiveBasePrice Decimal? @db.Decimal(14, 2)

  leads         Lead[]
  agePriceRules AgePriceRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catagories")
}
