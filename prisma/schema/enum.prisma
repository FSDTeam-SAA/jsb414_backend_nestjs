enum UserRole {
    superadmin
    admin
    user
}

enum SubscriptionStatus {
    ACTIVE
    CANCELLED
    EXPIRED
    PAST_DUE
}

enum PaymentType {
    SUBSCRIPTION
    LEAD_PURCHASE
    ACCOUNT_FUNDING
}

enum PaymentStatus {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
}

enum LeadStatus {
    ACTIVE
    INACTIVE
    ARCHIVED
}

enum LeadClassification {
    SELLABLE
    NEEDS_ENRICHMENT
    NEEDS_REVIEW
    REJECTED
}

enum LeadAvailability {
    SHARED    @map("Shared")
    EXCLUSIVE @map("Exclusive")
    BOTH      @map("Both")
}

enum LeadReviewStatus {
    PENDING
    MERGED
    CREATED_NEW
    REJECTED
}

enum PriceType {
    SHARED
    EXCLUSIVE
}

enum WalletTransactionType {
    TOP_UP // কাস্টমার নিজে ফান্ড অ্যাড করেছে ($100, $250 ইত্যাদি)
    PURCHASE // লিড কেনার জন্য ব্যালেন্স থেকে কাটা হয়েছে
    REFUND // ব্যাড লিডের টাকা রিফান্ড পেয়ে ওয়ালেটে যোগ হয়েছে
    ADMIN_ADJUSTMENT // অ্যাডমিন কোনো বোনাস বা ব্যালেন্স অ্যাডজাস্ট করেছে
}
