model Lead {
  id                      String           @id @default(uuid())
  leadNumber              Int              @unique @default(autoincrement())
  categoryId              String
  category                Catagorie        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  firstName               String?
  lastName                String?
  propertyAddress         String?
  unitNumber              String?
  city                    String?
  legacyPriceText         String? @map("price") // Old data retained, not used for pricing
  county                  String?
  state                   String?
  zipcode                 String?
  propertyType            String?
  propertyImage           String?
  estValue                Int?
  estEquity               Int?
  mortgageBalance         Int?
  saleDate                DateTime?
  stage                   String?
  mortgageInformation     String?
  phoneNumbers            String[]         @default([])
  emailAddresses          String[]         @default([])
  source                  String
  availability            LeadAvailability @default(SHARED)
  status                  String           @default("ACTIVE")
  classification          String           @default("NEEDS_ENRICHMENT")
  sharedLimit             Int?
  sharedSalesCount        Int              @default(0)
  exclusiveSoldAt         DateTime?
  lastImportedAt          DateTime?
  adminId                 String
  admin                   User             @relation(fields: [adminId], references: [id])
  cartItems               CartItem[]
  userLead                UserLead[]
  orderItems              OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}
