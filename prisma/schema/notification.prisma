model Notification {
    id        String           @id @default(uuid())
    userId    String
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    title     String
    message   String
    type      NotificationType @default(SYSTEM)
    link      String?
    isRead    Boolean          @default(false)
    createdAt DateTime         @default(now())

    @@index([userId, isRead])
    @@map("notifications")
}
