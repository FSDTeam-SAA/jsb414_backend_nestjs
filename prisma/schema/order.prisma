model Order {
  id          String @id @default(uuid())
  orderNumber String @unique // ফিগমার মতো ডিসপ্লে আইডি (যেমন: FG-ORD-10001)
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subtotal    Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  walletUsed Decimal @default(0) @db.Decimal(14, 2)
  cardPaid   Decimal @default(0) @db.Decimal(14, 2)

  status          PaymentStatus @default(COMPLETED)
  stripePaymentId String? // কার্ড পেমেন্টের ট্রানজেকশন আইডি
  receiptUrl      String? // ইনভয়েস লিংক

  orderItems OrderItem[]
  userLeads  UserLead[] // এই অর্ডারে কেনা স্থায়ী লিডগুলোর রিলেশন

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  leadId  String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Restrict)

  priceType          LeadAvailability // SHARED নাকি EXCLUSIVE
  originalPrice Decimal @db.Decimal(14, 2)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  pricePaid     Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@map("order_items")
}
