model User {
    id          String   @id @default(uuid())
    firstName   String
    lastName    String
    email       String   @unique
    password    String
    phoneNumber String?
    photo       String?
    role        UserRole @default(user)

    walletBalance Decimal @default(0) @db.Decimal(14, 2)

    otp            String?
    otpExpiry      DateTime?
    verifiedForget Boolean?

    verifiedEmail Boolean @default(false)

    // কাস্টমারের পছন্দের লিড ক্যাটাগরি ও এলাকা (Figma: What leads interest you?)
    leadTypes        String[] @default([])
    interestedStates String[] @default([])
    interestedCities String[] @default([])

    createdPlans       Subscribe[]         @relation("SubscribeCreatedBy")
    updatedPlans       Subscribe[]         @relation("SubscribeUpdatedBy")
    userSubscribes     UserSubscribe[]
    payments           Payment[]
    lead               Lead[]
    cartItems          CartItem[]
    userLead           UserLead[]
    savedSearches      SavedSearch[]
    orders             Order[]
    walletTransactions WalletTransaction[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}
