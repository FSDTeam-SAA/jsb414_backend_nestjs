model User {
    id          String   @id @default(uuid())
    firstName   String
    lastName    String
    email       String   @unique
    password    String
    phoneNumber String?
    photo       String?
    role        UserRole @default(user)

    walletBalanceCents Int @default(0)

    otp            String?
    otpExpiry      DateTime?
    verifiedForget Boolean?

    createdPlans   Subscribe[]     @relation("SubscribeCreatedBy")
    updatedPlans   Subscribe[]     @relation("SubscribeUpdatedBy")
    userSubscribes UserSubscribe[]
    payments       Payment[]
    lead           Lead[]
    cartItems      CartItem[]
    userLead       UserLead[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}
